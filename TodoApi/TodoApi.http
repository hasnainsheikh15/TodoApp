@TodoApi_HostAddress = http://localhost:5264

### Get all todos
GET {{TodoApi_HostAddress}}/api/Todo
Accept: application/json

### Get todos by search term
GET {{TodoApi_HostAddress}}/api/Todo?priority=Low
Accept: application/json

### Create a todo
POST {{TodoApi_HostAddress}}/api/Todo
Content-Type: application/json
{
  "title": "checking priority",
  "description": "Testing PUT request",
  "isCompleted": false,
  "priority": "Low",
  "category": "Work"
}


### Get todo by id
GET {{TodoApi_HostAddress}}/api/Todo/5
Accept: application/json


### Update todo
PUT {{TodoApi_HostAddress}}/api/Todo/5
Content-Type: application/json

{
  "title": "Finish Decisions assignment",
  "description": "Complete backend and frontend",
  "isCompleted": true,
  "priority": "High",
  "category": "Work"
}


### Delete todo
DELETE {{TodoApi_HostAddress}}/api/Todo/1


### Test custom 404
GET {{TodoApi_HostAddress}}/api/Todo/99999
Accept: application/json